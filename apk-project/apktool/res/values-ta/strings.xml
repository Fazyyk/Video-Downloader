    <string name="APKTOOL_RENAMED_0x7f120095">பாதியளவு விரிவாக்கும்</string>
    <string name="APKTOOL_RENAMED_0x7f1200aa">%2$d இல் %1$d எழுத்துகள் உள்ளிடப்பட்டுள்ளன</string>
    <string name="APKTOOL_RENAMED_0x7f1200ab">%2$d இல் %1$d எழுத்து வரம்பு மீறப்பட்டது</string>
