    <string name="APKTOOL_RENAMED_0x7f1200bd">இயக்கு</string>
    <string name="APKTOOL_RENAMED_0x7f1200be">Google Play சேவைகளை இயக்கினால் மட்டுமே, %1$s செயல்படும்.</string>
    <string name="APKTOOL_RENAMED_0x7f1200bf">Google Play சேவைகளை இயக்கவும்</string>
    <string name="APKTOOL_RENAMED_0x7f1200c0">நிறுவு</string>
    <string name="APKTOOL_RENAMED_0x7f1200c1">Google Play சேவைகள் இருந்தால் மட்டுமே, %1$s இயங்கும். அவை உங்கள் சாதனத்தில் இல்லை.</string>
    <string name="APKTOOL_RENAMED_0x7f1200c2">Google Play சேவைகளைப் பெறவும்</string>
    <string name="APKTOOL_RENAMED_0x7f1200c3">கிடைக்கும் Google Play சேவைகள்</string>
    <string name="APKTOOL_RENAMED_0x7f1200c4">Google Play சேவைகள் பிழை</string>
    <string name="APKTOOL_RENAMED_0x7f1200c5">Google Play சேவைகளில் சிக்கல் ஏற்பட்டதால், %1$s ஆப்ஸை அணுக முடியவில்லை. மீண்டும் முயலவும்.</string>
    <string name="APKTOOL_RENAMED_0x7f1200c6">Google Play சேவைகள் இருந்தால் மட்டுமே %1$s ஆப்ஸ் இயங்கும். ஆனால், உங்கள் சாதனத்தில் அவை ஆதரிக்கப்படவில்லை.</string>
    <string name="APKTOOL_RENAMED_0x7f1200c7">புதுப்பி</string>
    <string name="APKTOOL_RENAMED_0x7f1200c8">Google Play சேவைகளை இயக்கினால் மட்டுமே, %1$s செயல்படும்.</string>
    <string name="APKTOOL_RENAMED_0x7f1200c9">Google Play சேவைகளைப் புதுப்பிக்கவும்</string>
    <string name="APKTOOL_RENAMED_0x7f1200ca">தற்போது புதுப்பிக்கப்படும், Google Play சேவைகள் இருந்தால் மட்டுமே, %1$s செயல்படும்.</string>
    <string name="APKTOOL_RENAMED_0x7f1200cb">Google Play சேவைகளின் புதிய பதிப்பு தேவை. அது விரைவில் தானாகவே புதுப்பிக்கப்படும்.</string>
    <string name="APKTOOL_RENAMED_0x7f1200cc">மொபைலில் திற</string>
    <string name="APKTOOL_RENAMED_0x7f1200cd">உள்நுழைக</string>
    <string name="APKTOOL_RENAMED_0x7f1200ce">Google மூலம் உள்நுழைக</string>
