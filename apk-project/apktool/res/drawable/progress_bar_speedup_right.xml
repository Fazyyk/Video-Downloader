<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:topRightRadius="@dimen/cm_dp_4" android:bottomRightRadius="@dimen/cm_dp_4" />
            <solid android:color="@color/progress_bar_base_color" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:topRightRadius="@dimen/cm_dp_4" android:bottomRightRadius="@dimen/cm_dp_4" />
                <solid android:color="@color/speedup_color" />
            </shape>
        </clip>
    </item>
</layer-list>
