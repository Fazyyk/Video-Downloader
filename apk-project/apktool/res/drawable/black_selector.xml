<?xml version="1.0" encoding="utf-8"?>
<ripple android:color="#7fffffff"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#000000" />
            <corners android:radius="@dimen/cm_dp_2" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_pressed="false" android:drawable="@color/transparent" />
            <item android:state_pressed="true" android:drawable="@color/private_select" />
        </selector>
    </item>
</ripple>
