<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="APKTOOL_RENAMED_0x7f120021">இரத்து</string>
    <string name="APKTOOL_RENAMED_0x7f120022">தொடர்க</string>
    <string name="APKTOOL_RENAMED_0x7f120025">பதிவிறக்கம்</string>
    <string name="APKTOOL_RENAMED_0x7f12002d">திற</string>
    <string name="APKTOOL_RENAMED_0x7f12003e">அனுமதி</string>
    <string name="APKTOOL_RENAMED_0x7f120043">செயலியானது வலிந்து நிறுத்தப்பட்டது</string>
    <string name="APKTOOL_RENAMED_0x7f120052">கேட்பொலி</string>
    <string name="APKTOOL_RENAMED_0x7f120054">இங்கே திரும்பவந்து ’சேமி’ பொத்தானைத் தட்டுங்கள்</string>
    <string name="APKTOOL_RENAMED_0x7f120057">நிறுவுக</string>
    <string name="APKTOOL_RENAMED_0x7f120058">தயவுசெய்து முதலில் கூகுள் பிளேயிலிருந்து Android System WebViewவை நிறுவவும்.</string>
    <string name="APKTOOL_RENAMED_0x7f120059">இணையப்பக்கத்தைக் காட்ட இயலவில்லை.</string>
    <string name="APKTOOL_RENAMED_0x7f1200a8">சட்டக் கட்டுப்பாடுகள் காரணமாக, YouTube இல் உள்ள வீடியோக்களைப் பதிவிறக்க முடியாது.</string>
    <string name="APKTOOL_RENAMED_0x7f1200a9">உள்ளடக்கம் கிடைக்கவில்லை. தயவுசெய்து மற்றவற்றை பதிவிறக்கவும்</string>
    <string name="APKTOOL_RENAMED_0x7f1200d1">வாழ்த்துக்கள்! வெற்றிகரமாக பதிவிறக்கப்பட்டது.</string>
    <string name="APKTOOL_RENAMED_0x7f1200f4">பொறுப்புத் துறப்பு</string>
    <string name="APKTOOL_RENAMED_0x7f1200f5">"காணொளிகளை அல்லது புகைப்படங்களைத் திரும்பப் பதியுமுன் உரிமையாளரிடம் தயவுசெய்து அனுமதி பெறவும்;

எந்தவித அனுமதியற்ற செயல்களும்(மீண்டும் பதிவேற்றுவது அல்லது உள்ளடக்கங்களைப் பதிவிறக்குவது) மற்றும்/அல்லது அறிவுசார் சொத்துரிமைகளை மீறுவதும் முழுக்கவே பயனரின் பொறுப்பைச் சேர்ந்தது."</string>
    <string name="APKTOOL_RENAMED_0x7f1200fd">பதிவிறக்கம் முடிந்தது</string>
    <string name="APKTOOL_RENAMED_0x7f120102">பதிவிறக்க நேரம் முடிந்தது</string>
    <string name="APKTOOL_RENAMED_0x7f120103">பதிவிறக்க வேகம் மிகவும் மெதுவாக உள்ளது</string>
    <string name="APKTOOL_RENAMED_0x7f120105">%s பதிவிறக்கப்பட்டது</string>
    <string name="APKTOOL_RENAMED_0x7f120106">பின்புலத்தில் இயல்பான பதிவிறக்கத்தை உறுதிப்படுத்த, தயவுசெய்து Notification Bar அனுமதியை செயல்படுத்தவும்.</string>
    <string name="APKTOOL_RENAMED_0x7f120107">"சமூகப் பக்கங்களிலிருந்து அனைத்துக் காணொளிகளையும் விரைவாக பதிவிறக்குவதற்குரிய இலவச பதிவிறக்கி.

%s"</string>
    <string name="APKTOOL_RENAMED_0x7f12016a">இணைப்பு காலாவதியானது</string>
    <string name="APKTOOL_RENAMED_0x7f120170">பதிவிறக்க முடியவில்லை</string>
    <string name="APKTOOL_RENAMED_0x7f120174">குடும்பச் செயலிகள்</string>
    <string name="APKTOOL_RENAMED_0x7f120175">கருத்துரை</string>
    <string name="APKTOOL_RENAMED_0x7f120177">கருத்துக்கள் அல்லது கேள்விகள் உள்ளதா? எங்களிடம் சொல்லுங்கள்</string>
    <string name="APKTOOL_RENAMED_0x7f120180">இயல்புநிலை</string>
    <string name="APKTOOL_RENAMED_0x7f120182">பின்புல பதிவிறக்கத்துக்கு</string>
    <string name="APKTOOL_RENAMED_0x7f120184">%2$s-ல் %1$s பயன்படுத்தப்பட்டது</string>
    <string name="APKTOOL_RENAMED_0x7f12018a">நன்று</string>
    <string name="APKTOOL_RENAMED_0x7f120199">இது எப்படி இயங்குகிறது</string>
    <string name="APKTOOL_RENAMED_0x7f12019a">24 மணிநேரங்களுக்குப்பின் வாட்சப் உங்கள் நிலைத்தகவல்களை நீக்கிவிடும். அவை நீக்கப்படுமுன் இந்தச் செயலி மூலம் அவற்றை நீங்கள் சேமிக்கலாம்.</string>
    <string name="APKTOOL_RENAMED_0x7f12019b">எப்படி பதிவிறக்குவது</string>
    <string name="APKTOOL_RENAMED_0x7f1201ad">பிறகு</string>
    <string name="APKTOOL_RENAMED_0x7f1201b0">கூகுள் பிளேயில் மதிப்பிடுக்</string>
    <string name="APKTOOL_RENAMED_0x7f1201b1">மதிப்பிடுக</string>
    <string name="APKTOOL_RENAMED_0x7f1201b2">"சிறந்த பயனர் அனுபவத்துக்காக நாங்கள் கடுமையாகப் பணியாற்றுகிறோம். 
எங்களுக்கு தகுதி மதிப்பெண் அளிக்கமுடிந்தால் வெகுவாக வரவேற்கிறோம்."</string>
    <string name="APKTOOL_RENAMED_0x7f1201b4">எங்களுக்குக் கிடைத்ததில் சிறந்தது இது :)</string>
    <string name="APKTOOL_RENAMED_0x7f1201b5">தயவுசெய்து சில வரிகளில் மதிப்புரையைத் தாருங்கள்.</string>
    <string name="APKTOOL_RENAMED_0x7f1201b6">எங்களுக்கும் உங்களைப் பிடித்திருக்கிறது!</string>
    <string name="APKTOOL_RENAMED_0x7f1201b7">இதை விரும்புகிறேன்</string>
    <string name="APKTOOL_RENAMED_0x7f1201b8">ஓ, இல்லை!</string>
    <string name="APKTOOL_RENAMED_0x7f1201bb">உங்கள் மதிப்புரைக்கு நன்றி.</string>
    <string name="APKTOOL_RENAMED_0x7f120299">வலைத்தொடர்பு</string>
    <string name="APKTOOL_RENAMED_0x7f1202a0">காணொளிகளைத் தேடமுடியவில்லை</string>
    <string name="APKTOOL_RENAMED_0x7f1202a2">பதிவிறக்க வளங்களைக் கண்டறிய முடியவில்லை</string>
    <string name="APKTOOL_RENAMED_0x7f1202a6">&lt;strong>&lt;font color=#007AFF>தயவுசெய்து முதலில் காணொளியை இயக்கவும்&lt;/font>&lt;/strong>, %s காணொளியைக் கண்டறிந்ததும் பதிவிறக்க பொத்தான் தோன்றும்.</string>
    <string name="APKTOOL_RENAMED_0x7f1202ac">வாட்சப்பை கண்டறிய முடியவில்லை</string>
    <string name="APKTOOL_RENAMED_0x7f1202ad">போதிய இடமில்லை</string>
    <string name="APKTOOL_RENAMED_0x7f1202ae">அப்படியொன்றும் இல்லை</string>
    <string name="APKTOOL_RENAMED_0x7f1202c8">வாட்சப்பைத் திற</string>
    <string name="APKTOOL_RENAMED_0x7f1202d9">%s முறையாக இயங்குவதை உறுதிப்படுத்துவதற்கு அனுமதி தேவை.</string>
    <string name="APKTOOL_RENAMED_0x7f1202dc">அனுமதி தேவை</string>
    <string name="APKTOOL_RENAMED_0x7f1202de">"உங்கள் கைபேசியில் சேமிப்பிடம் குறைவாக உள்ளது! %sM மட்டுமே எஞ்சியுள்ளது.

தயவுசெய்து சில செயலிகளை நீக்கி எஞ்சிய இடம் 32M-க்கு அதிகமிருப்பதை உறுதிசெய்யுங்கள்."</string>
    <string name="APKTOOL_RENAMED_0x7f1202e5">இயக்கு</string>
    <string name="APKTOOL_RENAMED_0x7f120309">விளம்பரங்களை அகற்று</string>
    <string name="APKTOOL_RENAMED_0x7f12031e">ரிங்டோன்</string>
    <string name="APKTOOL_RENAMED_0x7f12035f">எங்கள் செயலி திருப்தியளிக்கிறதா?</string>
    <string name="APKTOOL_RENAMED_0x7f120360">கேலரியில் சேமிக்கப்பட்டது</string>
    <string name="APKTOOL_RENAMED_0x7f120370">அனுப்பு</string>
    <string name="APKTOOL_RENAMED_0x7f120373">சுவரொட்டியாக வை</string>
    <string name="APKTOOL_RENAMED_0x7f12037c">பகிர்</string>
    <string name="APKTOOL_RENAMED_0x7f12037d">இது பிடித்திருக்கிறதா? இதைப் பகிர்ந்து மேலும் பலருக்குத் தெரியப்படுத்துங்கள்!</string>
    <string name="APKTOOL_RENAMED_0x7f12037e">%s பயன்படுத்துவதற்கு நன்றி</string>
    <string name="APKTOOL_RENAMED_0x7f12037f">இப்போது பகிர்</string>
    <string name="APKTOOL_RENAMED_0x7f120381">நண்பர்களுடன் பகிர்</string>
    <string name="APKTOOL_RENAMED_0x7f120387">மற்றவை</string>
    <string name="APKTOOL_RENAMED_0x7f120389">சிறப்புச் சலுகை</string>
    <string name="APKTOOL_RENAMED_0x7f12038d">6x வேக பதிவிறக்கத்தைத் தொடங்கு</string>
    <string name="APKTOOL_RENAMED_0x7f120392">வாட்சப்புக்கான நிலைத்தகவல் சேமிப்பு</string>
    <string name="APKTOOL_RENAMED_0x7f12039d">உதவிக்குறிப்புகள்</string>
    <string name="APKTOOL_RENAMED_0x7f12039e">நீங்கள் எதிர்கொண்ட சிக்கலை எங்களிடம் சொல்லுங்கள்</string>
    <string name="APKTOOL_RENAMED_0x7f1203a0">எதிர்கால பதிப்பில் இதை நாங்கள் சரிசெய்வோம். சிரமத்திற்கு வருந்துகிறோம்.</string>
    <string name="APKTOOL_RENAMED_0x7f1203a1">உங்கள் கருத்துரைக்கு நன்றி</string>
    <string name="APKTOOL_RENAMED_0x7f1203b6">மிக அதிகளவு விளம்பரங்கள்</string>
    <string name="APKTOOL_RENAMED_0x7f12045a">காணொளிகளைப் பதிவிறக்குவதற்கு இரண்டு படிநிலைகள்</string>
    <string name="APKTOOL_RENAMED_0x7f12045b">வகை</string>
    <string name="APKTOOL_RENAMED_0x7f12045c">தயவுசெய்து உங்கள் சிக்கலை விளக்கவும் (குறைந்தது %s எழுத்துருக்கள்)</string>
    <string name="APKTOOL_RENAMED_0x7f12046d">சட்டப்பூர்வ கட்டுப்பாடுகளினால் இந்தக் காணொளியை பதிவிறக்க முடியாது. தயவுசெய்து மற்றவற்றை முயற்சிக்கவும்.</string>
    <string name="APKTOOL_RENAMED_0x7f120470">காண்க</string>
    <string name="APKTOOL_RENAMED_0x7f120471">வாட்சப்பில் நிலையைக் காட்டு</string>
</resources>
